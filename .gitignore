node_modules/

# Local settings (not committed)
.claude/settings.local.json
.claude/cca.config.json
.claude/commands/deploy-to-npmjs.md

# Per-install opt-in flags (this repo's own toggles — shipping one would flip the
# feature on for every fresh install; see the status-beeps opt-in design)
.claude/sounds/*.enabled

# Windows null device workaround
nul

# Internal planning docs (not distributed)
.claude/plans/

# Claude Code temp files
tmpclaude-*

# Terminal-title per-session state (runtime scratch, never distributed)
.claude/hooks/.titles/

# token-guard runtime cache (official-usage fetch, per-session accumulators — runtime scratch)
.claude/hooks/.token-guard/

# Session handoff notes (migrate-new-session — local, never distributed)
.claude/handoff/

# Test temp directories
test/.test-temp-*

# c8 coverage output (npm run coverage — visibility only, never committed)
coverage/

# Session-rendered article archive (/create-web-page output, local-only)
ARTICLES/

# Per-session WIP snapshots (/create-wip-report output). Stale within hours and would
# churn on every merge — regenerated, never committed.
#
# reports/wip/done/ is the exception and IS tracked: those notes describe finished work, so
# they never regenerate and never churn. They are the archive the lessons are read out of.
# reports/eod/ (/eod-report output) is tracked for the same reason — a day's wrap-up carries
# the open loops that existed only in a session's context, which no command can re-derive
# later — and needs no negation, since only the wip/ subtree is ignored.
# Note the glob — `reports/wip/` (trailing slash) would exclude the directory itself and git
# would never descend far enough to see the negation. `reports/wip/*` excludes the contents.
reports/wip/*
!reports/wip/done/

# Root WIP and QA scratch directories (local-only session audits)
wip/
qa/

# Local feature pilots / experiments (not distributed)
pilots/

# Per-machine hook fleet list (personal repo paths — never committed;
# see scripts/sync-hook-fleet.js). Both names: the second is the terminal-title-era
# original, still read as a fallback so an existing box needs no migration.
scripts/hook-fleet.local.json
scripts/terminal-title-fleet.local.json

# Python bytecode (recover-session.py imported by tests)
__pycache__/
