{
  "name": "claude-code-autoconfig",
  "version": "1.0.223",
  "description": "Intelligent, self-configuring setup for Claude Code. One command analyzes your project, configures Claude, and shows you what it did.",
  "author": "ADAC 1001 <info@adac1001.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/design-and-deliver/claude-code-autoconfig.git"
  },
  "homepage": "https://github.com/design-and-deliver/claude-code-autoconfig#readme",
  "bugs": {
    "url": "https://github.com/design-and-deliver/claude-code-autoconfig/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "autoconfig",
    "configuration",
    "cli"
  ],
  "scripts": {
    "test": "node test/box-alignment.test.js && node test/cli-install.test.js && node test/auto-guard.test.js && node test/update-system.test.js && node test/plugin-system.test.js && node test/terminal-title.test.js && node test/golden-endings.test.js && node test/live-twin-parity.test.js && node test/hook-fleet-sync.test.js && node test/update-summary.test.js && node test/changelog-gen.test.js && node test/dev-gate-consistency.test.js && node test/corrupt-json.test.js && node test/cli-behavior.test.js && node test/contracts.test.js && node test/complexity-ratchet.test.js && node test/gls-downscale.test.js && node test/ccr.test.js && node test/token-guard-copy.test.js && node test/token-guard-divert.test.js && node test/token-guard-reread.test.js && node test/token-guard-liveness.test.js && node test/token-guard-recovery.test.js && node test/token-guard-session-gate.test.js && node test/token-guard-bomb-gate.test.js && node test/recover-session-cap.test.js && node test/whats-happening.test.js && node test/fleet.test.js && node test/sync-worktrees.test.js && node test/restore-after-reboot.test.js && node test/plan-progress.test.js && node test/hook-tests.test.js",
    "preversion": "npm test",
    "prepublishOnly": "npm test",
    "test:hooks": "node test/hook-tests.test.js",
    "coverage": "c8 npm test",
    "pub": "npm whoami && npm publish",
    "test:box": "node test/box-alignment.test.js",
    "test:install": "node test/cli-install.test.js",
    "test:update": "node test/update-system.test.js",
    "postversion": "node scripts/generate-changelog.js --postversion",
    "test:guard": "node test/auto-guard.test.js",
    "lint": "eslint ."
  },
  "bin": {
    "claude-code-autoconfig": "bin/cli.js"
  },
  "files": [
    "bin",
    ".claude",
    "!.claude/settings.local.json",
    "!.claude/hooks/.titles",
    "!.claude/hooks/.token-guard",
    "!.claude/hooks/.token-guard/**",
    "!.claude/hooks/.titles/**",
    "!.claude/hooks/tests",
    "!.claude/hooks/tests/**",
    "!.claude/hooks/token-guard.js",
    "!.claude/hooks/token-guard-liveness.js",
    "!.claude/hooks/session-close.js",
    "!.claude/hooks/statusline-cost.js",
    "!.claude/hooks/worktree-gate.js",
    "!.claude/hooks/claim-registry.js",
    "!.claude/cca.config.json",
    "!.claude/.autoconfig-version",
    "!.claude/.autoconfig-plugins.json",
    "!.claude/.autoconfig-timing.jsonl",
    "!.claude/commands/deploy-to-npmjs.md",
    "!.claude/commands/usage-report.md",
    "!.claude/commands/analyze-session.md",
    "!.claude/commands/migrate-new-session.md",
    "!.claude/commands/plan-progress.md",
    "!.claude/scripts/plan-progress.js",
    "!.claude/commands/whats-happening.md",
    "!.claude/scripts/whats-happening.js",
    "!.claude/commands/fleet.md",
    "!.claude/scripts/fleet.js",
    "!.claude/commands/sync-worktrees.md",
    "!.claude/scripts/sync-worktrees.js",
    "!.claude/commands/restore-after-reboot.md",
    "!.claude/scripts/restore-after-reboot.js",
    "!.claude/commands/refactor.md",
    "!.claude/commands/cost-compare.md",
    "!.claude/commands/gimme-one-liner.md",
    "!.claude/commands/create-wip-report.md",
    "!.claude/commands/abort-plan.md",
    "!.claude/commands/eod-report.md",
    "!.claude/commands/cost-control-details.md",
    "!.claude/rules/parallel-session-worktrees.md",
    "!.claude/plans",
    "!.claude/worktrees",
    "!.claude/worktrees/**",
    "!.claude/checkpoints",
    "!.claude/checkpoints/**",
    "!.claude/mailbox",
    "!.claude/mailbox/**",
    "!.claude/routines/.state",
    "!.claude/routines/.state/**",
    "!.claude/cross-session-instructions",
    "!.claude/cross-session-instructions/**",
    "!.claude/agent-memory-local",
    "!.claude/agent-memory-local/**",
    "!.claude/scheduled_tasks.lock",
    "!.claude/scheduled_tasks.json",
    "!.claude/agent-registry.json",
    "!.claude/assistant-daemon-state.json",
    "!.claude/first-run",
    "!.claude/sounds/*.enabled",
    "CLAUDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  }
}
