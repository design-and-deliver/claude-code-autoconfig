{
  "name": "claude-code-autoconfig",
  "version": "1.0.213",
  "description": "Intelligent, self-configuring setup for Claude Code. One command analyzes your project, configures Claude, and shows you what it did.",
  "author": "ADAC 1001 <info@adac1001.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/design-and-deliver/claude-code-autoconfig.git"
  },
  "homepage": "https://github.com/design-and-deliver/claude-code-autoconfig#readme",
  "bugs": {
    "url": "https://github.com/design-and-deliver/claude-code-autoconfig/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "autoconfig",
    "configuration",
    "cli"
  ],
  "scripts": {
    "test": "node test/box-alignment.test.js && node test/cli-install.test.js && node test/update-system.test.js && node test/plugin-system.test.js && node test/terminal-title.test.js && node test/golden-endings.test.js && node test/live-twin-parity.test.js && node test/update-summary.test.js && node test/changelog-gen.test.js && node test/hook-tests.test.js",
    "test:hooks": "node test/hook-tests.test.js",
    "pub": "npm whoami && npm publish",
    "test:box": "node test/box-alignment.test.js",
    "test:install": "node test/cli-install.test.js",
    "test:update": "node test/update-system.test.js",
    "postversion": "node scripts/generate-changelog.js --postversion"
  },
  "bin": {
    "claude-code-autoconfig": "bin/cli.js",
    "ccr": "bin/ccr.js"
  },
  "files": [
    "bin",
    ".claude",
    "!.claude/settings.local.json",
    "!.claude/hooks/.titles",
    "!.claude/hooks/.token-guard",
    "!.claude/hooks/.token-guard/**",
    "!.claude/hooks/.titles/**",
    "!.claude/hooks/tests",
    "!.claude/hooks/tests/**",
    "!.claude/cca.config.json",
    "!.claude/.autoconfig-version",
    "!.claude/.autoconfig-plugins.json",
    "!.claude/commands/deploy-to-npmjs.md",
    "!.claude/plans",
    "!.claude/sounds/*.enabled",
    "CLAUDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
